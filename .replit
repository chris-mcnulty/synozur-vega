modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["imagemagick", "unzip", "jq", "zip"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-portal"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-trash-restore"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-dashboard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-saved-views"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-comments-mentions"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "test-portal"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/__tests__/galaxyPortal.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-trash-restore"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/__tests__/trashAndRestore.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/__tests__/dashboardContext.test.ts"

[workflows.workflow.metadata]
outputType = "console"
isValidation = true

[[workflows.workflow]]
name = "test-saved-views"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/__tests__/savedViews.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "test-comments-mentions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/__tests__/commentsAndMentions.test.ts"

[workflows.workflow.metadata]
outputType = "console"
isValidation = true

[agent]
integrations = ["javascript_mem_db:1.0.0", "outlook:1.0.0", "javascript_openai_ai_integrations:1.0.0", "sendgrid:1.0.0", "onedrive:1.0.0", "sharepoint:1.0.0", "hubspot:1.0.0", "javascript_object_storage:2.0.0"]

[userenv]

[userenv.shared]
TOKEN_ENCRYPTION_SECRET = "VegaSecureToken2024xK9mPqRsT5nL8wY3jF6vB2hD4cE7gA1iO0uZ"
AZURE_BASE_URL = "https://vega.synozur.com"
MCP_ENTRA_CLIENT_ID = "8e7d9752-beae-461e-b041-d2ee9dea0051"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
